<Window x:Class="WindowsPersonalizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Personalizer" Width="1060" Height="720" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Icon="app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{StaticResource SidebarBg}">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,18">
                    <TextBlock Text="Personalizer" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Make Windows look like anything" Style="{StaticResource Hint}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="RestoreButton" Content="Restore original look" Click="Restore_Click" Margin="0,0,0,6"
                            HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="BackupText" Style="{StaticResource Hint}" Margin="4,0,0,0" />
                </StackPanel>

                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" SelectionChanged="Nav_SelectionChanged"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="Themes" IsSelected="True"><TextBlock><Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE790;" />  Themes</TextBlock></ListBoxItem>
                    <ListBoxItem Tag="Appearance"><TextBlock><Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE771;" />  Colors &amp; mode</TextBlock></ListBoxItem>
                    <ListBoxItem Tag="Taskbar"><TextBlock><Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE75B;" />  Taskbar &amp; desktop</TextBlock></ListBoxItem>
                    <ListBoxItem Tag="Dock"><TextBlock><Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8A9;" />  Dock</TextBlock></ListBoxItem>
                    <ListBoxItem Tag="TopBar"><TextBlock><Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE737;" />  Top bar</TextBlock></ListBoxItem>
                    <ListBoxItem Tag="Wallpaper"><TextBlock><Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE91B;" />  Wallpaper</TextBlock></ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="28,20,28,10">
                <TextBlock x:Name="PageTitle" Text="Themes" Style="{StaticResource H1}" />
                <TextBlock x:Name="PageHint" Style="{StaticResource Hint}" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,4,28,12">
                <Grid>
                    <!-- ===== Themes ===== -->
                    <StackPanel x:Name="PageThemes">
                        <WrapPanel x:Name="PresetPanel" />
                        <Border Style="{StaticResource Card}" Margin="0,8,0,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Your own themes" Style="{StaticResource H2}" Margin="0,0,0,2" />
                                    <TextBlock Text="Save everything you've set up to a file, or load one someone shared." Style="{StaticResource Hint}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="Import theme…" Click="Import_Click" />
                                    <Button Content="Export theme…" Click="Export_Click" Margin="0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Colors & mode ===== -->
                    <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Mode" Style="{StaticResource H2}" />
                                <CheckBox x:Name="DarkApps" Content="Dark mode for apps" />
                                <CheckBox x:Name="DarkSystem" Content="Dark mode for Windows (taskbar, Start, dock, top bar)" />
                                <CheckBox x:Name="Transparency" Content="Transparency effects" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Accent color" Style="{StaticResource H2}" />
                                <WrapPanel x:Name="AccentSwatches" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="AccentPreview" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0" />
                                    <TextBox x:Name="AccentHex" Width="110" TextChanged="AccentHex_TextChanged" />
                                    <Button Content="Pick any color…" Click="PickAccent_Click" Margin="10,0,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="AccentOnTaskbar" Content="Show accent color on Start and taskbar (needs dark Windows mode)" Margin="0,12,0,5" />
                                <CheckBox x:Name="AccentOnTitleBars" Content="Show accent color on window title bars" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Taskbar & desktop ===== -->
                    <StackPanel x:Name="PageTaskbar" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Windows taskbar" Style="{StaticResource H2}" />
                                <WrapPanel>
                                    <RadioButton x:Name="TaskbarNormal" GroupName="tb" Content="Always show" />
                                    <RadioButton x:Name="TaskbarAutoHide" GroupName="tb" Content="Auto-hide" />
                                    <RadioButton x:Name="TaskbarHidden" GroupName="tb" Content="Hide completely (use the Dock instead)" />
                                </WrapPanel>
                                <DockPanel Style="{StaticResource Row}" Margin="0,10,0,5">
                                    <TextBlock Text="Taskbar icons" VerticalAlignment="Center" />
                                    <ComboBox x:Name="TaskbarAlign" DockPanel.Dock="Right">
                                        <ComboBoxItem Content="Centered (Windows 11)" />
                                        <ComboBoxItem Content="Left (Windows 10 / Linux)" />
                                    </ComboBox>
                                </DockPanel>
                                <CheckBox x:Name="ShowSearch" Content="Search button" />
                                <CheckBox x:Name="ShowTaskView" Content="Task View button" />
                                <CheckBox x:Name="ShowWidgets" Content="Widgets button" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="Some taskbar changes only appear after Explorer restarts (button at the bottom)." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Desktop &amp; startup" Style="{StaticResource H2}" />
                                <CheckBox x:Name="ShowDesktopIcons" Content="Show desktop icons" />
                                <CheckBox x:Name="StartWithWindows" Content="Start with Windows (keeps your dock and top bar after a reboot)" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Dock ===== -->
                    <StackPanel x:Name="PageDock" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="DockEnabled" Content="Show the Dock" FontWeight="SemiBold" />
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Position on screen" VerticalAlignment="Center" />
                                    <ComboBox x:Name="DockPosition" DockPanel.Dock="Right">
                                        <ComboBoxItem Content="Bottom" Tag="Bottom" />
                                        <ComboBoxItem Content="Left" Tag="Left" />
                                        <ComboBoxItem Content="Right" Tag="Right" />
                                        <ComboBoxItem Content="Top" Tag="Top" />
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Style" VerticalAlignment="Center" />
                                    <ComboBox x:Name="DockStyleBox" DockPanel.Dock="Right">
                                        <ComboBoxItem Content="Floating (macOS)" />
                                        <ComboBoxItem Content="Edge panel (Ubuntu)" />
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Icon size" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Slider x:Name="DockSize" Minimum="28" Maximum="96" Width="200" TickFrequency="2"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Value, ElementName=DockSize, StringFormat={}{0:0} px}" Width="50"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                                <CheckBox x:Name="DockMagnify" Content="Magnify icons on hover" />
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Magnification" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Slider x:Name="DockMag" Minimum="1.1" Maximum="2.4" Width="200" TickFrequency="0.1"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                IsEnabled="{Binding IsChecked, ElementName=DockMagnify}" />
                                        <TextBlock Text="{Binding Value, ElementName=DockMag, StringFormat={}{0:0.0}×}" Width="50"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                                <CheckBox x:Name="DockReserve" Content="Keep windows from covering the Dock" />
                                <CheckBox x:Name="DockRunning" Content="Show a dot under running apps" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Apps in the Dock" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                           Text="Tip: you can also drag any app, shortcut or folder straight onto the Dock, and right-click an icon to remove it." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ListBox x:Name="DockList" Height="240" BorderBrush="{StaticResource CardBorder}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="130">
                                        <Button Content="Add app…" Click="DockAdd_Click" Margin="0,0,0,6" />
                                        <Button Content="Add folder…" Click="DockAddFolder_Click" Margin="0,0,0,6" />
                                        <Button Content="Remove" Click="DockRemove_Click" Margin="0,0,0,6" />
                                        <Button Content="Move up" Click="DockUp_Click" Margin="0,0,0,6" />
                                        <Button Content="Move down" Click="DockDown_Click" Margin="0,0,0,6" />
                                        <Button Content="Reset to default" Click="DockReset_Click" Margin="0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Top bar ===== -->
                    <StackPanel x:Name="PageTopBar" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="TopBarEnabled" Content="Show a bar across the top of the screen" FontWeight="SemiBold" />
                                <DockPanel Style="{StaticResource Row}">
                                    <TextBlock Text="Style" VerticalAlignment="Center" />
                                    <ComboBox x:Name="TopBarStyleBox" DockPanel.Dock="Right">
                                        <ComboBoxItem Content="macOS menu bar" />
                                        <ComboBoxItem Content="GNOME / Ubuntu panel" />
                                    </ComboBox>
                                </DockPanel>
                                <CheckBox x:Name="Clock24h" Content="24-hour clock" />
                                <CheckBox x:Name="ClockDate" Content="Show the date" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="The top bar shows the app you're using, a clock, and buttons for search, Wi-Fi/sound (Quick Settings) and notifications. The menu on the left has Settings, Sleep, Restart, Shut Down and Lock." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Wallpaper ===== -->
                    <StackPanel x:Name="PageWallpaper" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton x:Name="WallKeep" GroupName="wp" Content="Keep my wallpaper" Checked="Wallpaper_Changed" />
                                    <RadioButton x:Name="WallGenerated" GroupName="wp" Content="Generated gradient" Checked="Wallpaper_Changed" />
                                    <RadioButton x:Name="WallImage" GroupName="wp" Content="Picture file" Checked="Wallpaper_Changed" />
                                </WrapPanel>

                                <StackPanel x:Name="GeneratedPanel">
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Style" VerticalAlignment="Center" />
                                        <ComboBox x:Name="WallStyle" DockPanel.Dock="Right" SelectionChanged="Wallpaper_Changed">
                                            <ComboBoxItem Content="Waves" />
                                            <ComboBoxItem Content="Soft mesh" />
                                            <ComboBoxItem Content="Linear gradient" />
                                            <ComboBoxItem Content="Solid color" />
                                        </ComboBox>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Row}">
                                        <TextBlock Text="Colors" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <TextBox x:Name="WallC1" Width="82" Margin="0,0,6,0" TextChanged="Wallpaper_Changed" />
                                            <TextBox x:Name="WallC2" Width="82" Margin="0,0,6,0" TextChanged="Wallpaper_Changed" />
                                            <TextBox x:Name="WallC3" Width="82" Margin="0,0,6,0" TextChanged="Wallpaper_Changed" />
                                            <TextBox x:Name="WallC4" Width="82" Margin="0,0,6,0" TextChanged="Wallpaper_Changed" />
                                            <Button Content="Shuffle" Click="WallShuffle_Click" Margin="0" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>

                                <DockPanel x:Name="ImagePanel" Style="{StaticResource Row}" LastChildFill="True">
                                    <Button Content="Browse…" DockPanel.Dock="Right" Click="WallBrowse_Click" Margin="8,0,0,0" />
                                    <TextBox x:Name="WallPath" TextChanged="Wallpaper_Changed" />
                                </DockPanel>

                                <Border CornerRadius="8" Margin="0,12,0,0" ClipToBounds="True" HorizontalAlignment="Left"
                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                    <Image x:Name="WallPreview" Width="480" Height="270" Stretch="UniformToFill" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ============ Footer ============ -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="28,12">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Restart Explorer" Click="RestartExplorer_Click"
                                ToolTip="Reloads the Windows taskbar so every change shows up" />
                        <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource PrimaryButton}" Click="Apply_Click"
                                Padding="28,8" Margin="0" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource Hint}" FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
